# Token bot lấy từ @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Danh sách chat ID nhận báo cáo và được phép dùng lệnh (cách nhau bởi dấu phẩy).
# Dùng lệnh /chatid với bot để lấy ID. Group chat có ID âm, ví dụ -1001234567890
TELEGRAM_CHAT_IDS=123456789

# Access token Facebook (nên dùng System User token, quyền ads_read)
FB_ACCESS_TOKEN=EAAB...

# Một hoặc nhiều tài khoản quảng cáo, cách nhau bởi dấu phẩy (có hoặc không có tiền tố act_)
FB_AD_ACCOUNT_IDS=act_1234567890,9876543210

# Phiên bản Graph API
FB_API_VERSION=v21.0

# Giờ gửi báo cáo hàng ngày (HH:MM) và múi giờ
REPORT_TIME=08:00
TIMEZONE=Asia/Ho_Chi_Minh

# Số chiến dịch chi tiêu cao nhất hiển thị cho mỗi tài khoản
TOP_CAMPAIGNS=5
