# ── Local proxy (server/) ─────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# Shared secret the browser UI sends as "Authorization: Bearer <token>".
# Use a long random string (min 16 chars), e.g.: node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
# If empty, a temporary token is generated and printed at startup.
APP_ACCESS_TOKEN=

HOST=127.0.0.1
PORT=8787
# Origins allowed to call the proxy (the Vite dev / preview URLs).
# "null" = the standalone HTML file opened by double-click (file://).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,null
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_HOUR=20

# ── Review data provider (a third-party API you have a licence/plan for) ─
# The URL template must be https and contain {productId}; {page} is optional.
# Example (shape only – check your provider's docs for the real endpoint and parameters):
# REVIEW_API_URL_TEMPLATE=https://api.your-provider.example/aliexpress/reviews?product_id={productId}&page={page}
REVIEW_PROVIDER_NAME=
REVIEW_API_URL_TEMPLATE=
# Optional product-info endpoint (title, rating, review count).
PRODUCT_API_URL_TEMPLATE=
REVIEW_API_KEY=
# Header that carries the key, e.g. x-api-key, X-RapidAPI-Key, Authorization
REVIEW_API_KEY_HEADER=x-api-key
# Prefix for the key value, e.g. "Bearer " when the header is Authorization
REVIEW_API_KEY_PREFIX=
# Extra static headers as JSON, e.g. {"X-RapidAPI-Host":"example.p.rapidapi.com"}
REVIEW_API_EXTRA_HEADERS=
# Allow the UI to supply the provider key (Settings page) when REVIEW_API_KEY is empty.
ALLOW_CLIENT_PROVIDER_KEY=true

# ── AI analysis (Anthropic Claude) ───────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ALLOW_CLIENT_ANTHROPIC_KEY=true
