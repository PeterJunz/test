{
  "name": "aliexpress-review-analyzer-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Filter, classify and analyze AliExpress product reviews from legitimate data sources.",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:standalone": "tsc -b && vite build --mode standalone && node scripts/rename-standalone.mjs",
    "build:extension": "tsc -b && vite build --mode extension && node scripts/package-extension.mjs",
    "build:release": "npm run build:standalone && npm run build:extension"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.58.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
