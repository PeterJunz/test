{
  "name": "getsmarthome-hero-demos",
  "private": true,
  "version": "0.1.0",
  "description": "10 prototype 3D hero banners (Three.js + GLSL + GSAP) for getsmarthome.net — Warm Premium, home & lifestyle.",
  "type": "module",
  "scripts": {
    "serve": "npx --yes http-server . -p 5173 -c-1",
    "pages": "node tools/make-pages.mjs",
    "check": "node tools/check.mjs",
    "check:reduced": "MODE=reduced node tools/check.mjs",
    "check:nowebgl": "MODE=nowebgl node tools/check.mjs",
    "build:shopify": "node tools/build-shopify.mjs"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "gsap": "3.12.5",
    "playwright-core": "1.64.0",
    "three": "0.170.0"
  }
}
