<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {% render 'meta-tags' %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- assign heading_font = settings.heading_font_family | default: 'Be Vietnam Pro' | replace: ' ', '+' -%}
    {%- assign body_font = settings.body_font_family | default: 'Be Vietnam Pro' | replace: ' ', '+' -%}
    <link href="https://fonts.googleapis.com/css2?family={{ heading_font }}:wght@600;800&family={{ body_font }}:wght@400;600&display=swap" rel="stylesheet">
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password text-effect--{{ settings.text_effect }}">
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
