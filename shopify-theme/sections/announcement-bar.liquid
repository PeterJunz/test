{%- if section.blocks.size > 0 -%}
  <div class="announcement" style="--ann-bg: {{ section.settings.background }}; --ann-color: {{ section.settings.text_color }};" {{ section.shopify_attributes }}>
    <div class="announcement__track" data-announcement data-speed="{{ section.settings.speed }}">
      {%- for block in section.blocks -%}
        <p class="announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Thanh thông báo",
  "class": "section-announcement",
  "max_blocks": 6,
  "settings": [
    { "type": "color", "id": "background", "label": "Màu nền", "default": "#1f7a6f" },
    { "type": "color", "id": "text_color", "label": "Màu chữ", "default": "#ffffff" },
    { "type": "range", "id": "speed", "label": "Đổi thông báo sau (giây)", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Thông báo",
      "settings": [
        { "type": "text", "id": "text", "label": "Nội dung", "default": "Miễn phí vận chuyển cho đơn hàng từ 500.000₫" },
        { "type": "url", "id": "link", "label": "Liên kết" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Thanh thông báo",
      "blocks": [
        { "type": "announcement", "settings": { "text": "🚚 Miễn phí vận chuyển cho đơn hàng từ 500.000₫" } },
        { "type": "announcement", "settings": { "text": "🎁 Giảm 10% cho đơn hàng đầu tiên – Nhập mã: XINCHAO" } }
      ]
    }
  ]
}
{% endschema %}
