<footer class="footer">
  <div class="page-width">
    <div class="footer__grid">
      {%- for block in section.blocks -%}
        <div class="footer__col footer__col--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'brand' -%}
              <p class="footer__brand emboss">{{ shop.name }}</p>
              <div class="rte footer__about">{{ block.settings.text }}</div>
              <ul class="footer__social">
                {%- assign networks = 'facebook,instagram,tiktok,youtube' | split: ',' -%}
                {%- for network in networks -%}
                  {%- assign key = 'social_' | append: network -%}
                  {%- if settings[key] != blank -%}
                    <li><a href="{{ settings[key] }}" class="icon-btn icon-btn--raised" target="_blank" rel="noopener" aria-label="{{ network | capitalize }}">{% render 'icon', name: network %}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- when 'menu' -%}
              <h3 class="footer__title">{{ block.settings.heading | escape }}</h3>
              <ul class="footer__links">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- when 'contact' -%}
              <h3 class="footer__title">{{ block.settings.heading | escape }}</h3>
              <ul class="footer__contact">
                {%- if block.settings.phone != blank -%}
                  <li>{% render 'icon', name: 'phone' %}<a href="tel:{{ block.settings.phone | remove: ' ' | remove: '.' }}">{{ block.settings.phone | escape }}</a></li>
                {%- endif -%}
                {%- if block.settings.email != blank -%}
                  <li>{% render 'icon', name: 'mail' %}<a href="mailto:{{ block.settings.email }}">{{ block.settings.email | escape }}</a></li>
                {%- endif -%}
                {%- if block.settings.address != blank -%}
                  <li>{% render 'icon', name: 'pin' %}<span>{{ block.settings.address | escape }}</span></li>
                {%- endif -%}
                {%- if block.settings.hours != blank -%}
                  <li>{% render 'icon', name: 'clock' %}<span>{{ block.settings.hours | escape }}</span></li>
                {%- endif -%}
              </ul>
            {%- when 'newsletter' -%}
              <h3 class="footer__title">{{ block.settings.heading | escape }}</h3>
              <p class="footer__note">{{ block.settings.text | escape }}</p>
              {% render 'newsletter-form', form_id: 'FooterNewsletter' %}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. {{ section.settings.copyright | escape }}</p>
      {%- if section.settings.show_payment -%}
        <ul class="footer__payments" aria-label="{{ 'general.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Chân trang",
  "class": "section-footer",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "copyright", "label": "Dòng bản quyền", "default": "Bảo lưu mọi quyền." },
    { "type": "checkbox", "id": "show_payment", "label": "Hiện biểu tượng thanh toán", "default": true }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Giới thiệu thương hiệu",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Giới thiệu", "default": "<p>Cửa hàng chăm sóc sức khỏe, thú cưng và mẹ & bé – sản phẩm chọn lọc, chính hãng.</p>" },
        { "type": "paragraph", "content": "Liên kết mạng xã hội cài đặt trong Cài đặt theme > Mạng xã hội" }
      ]
    },
    {
      "type": "menu",
      "name": "Menu liên kết",
      "settings": [
        { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Danh mục" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "contact",
      "name": "Liên hệ",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Liên hệ" },
        { "type": "text", "id": "phone", "label": "Hotline", "default": "1900 0000" },
        { "type": "text", "id": "email", "label": "Email", "default": "hotro@cuahang.vn" },
        { "type": "text", "id": "address", "label": "Địa chỉ", "default": "123 Nguyễn Huệ, Quận 1, TP. Hồ Chí Minh" },
        { "type": "text", "id": "hours", "label": "Giờ làm việc", "default": "8:00 – 21:00, tất cả các ngày" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Đăng ký nhận tin",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Nhận ưu đãi" },
        { "type": "text", "id": "text", "label": "Mô tả", "default": "Giảm 10% cho đơn hàng đầu tiên khi đăng ký." }
      ]
    }
  ],
  "presets": [{ "name": "Chân trang" }]
}
{% endschema %}
