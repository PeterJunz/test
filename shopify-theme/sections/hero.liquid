{%- liquid
  assign s = section.settings
  assign featured_a = s.product_a
  assign featured_b = s.product_b
-%}
<section class="hero section" style="--hero-glow: {{ s.glow_color }};">
  <div class="page-width hero__grid">
    <div class="hero__content">
      {%- if s.eyebrow != blank -%}
        <p class="eyebrow eyebrow--pill">{% render 'icon', name: 'sparkle' %} {{ s.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="hero__title emboss emboss--strong">{{ s.heading }}</h1>
      {%- if s.text != blank -%}
        <div class="hero__text rte">{{ s.text }}</div>
      {%- endif -%}
      <div class="hero__buttons">
        {%- if s.button_label != blank -%}
          <a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--lg">
            {{ s.button_label | escape }} {% render 'icon', name: 'arrow-right' %}
          </a>
        {%- endif -%}
        {%- if s.button2_label != blank -%}
          <a href="{{ s.button2_link | default: routes.collections_url }}" class="btn btn--soft btn--lg">{{ s.button2_label | escape }}</a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="hero__stats">
          {%- for block in section.blocks -%}
            <li class="hero__stat" {{ block.shopify_attributes }}>
              <strong class="emboss">{{ block.settings.value | escape }}</strong>
              <span>{{ block.settings.label | escape }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="hero__visual">
      <div class="hero__blob" aria-hidden="true"></div>
      <div class="hero__image raised">
        {%- if s.image != blank -%}
          {{
            s.image
            | image_url: width: 1400
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '480, 720, 960, 1200, 1400',
              sizes: '(min-width: 990px) 50vw, 100vw'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      {%- for featured in (1..2) -%}
        {%- if forloop.first -%}{%- assign p = featured_a -%}{%- else -%}{%- assign p = featured_b -%}{%- endif -%}
        {%- if p != blank -%}
          <a href="{{ p.url }}" class="hero__float hero__float--{{ forloop.index }} raised">
            <span class="hero__float-img">
              {%- if p.featured_media -%}
                {{ p.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: p.title }}
              {%- endif -%}
            </span>
            <span class="hero__float-info">
              <span class="hero__float-title">{{ p.title | escape | truncate: 34 }}</span>
              {% render 'price', product: p %}
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}

      {%- if s.badge_text != blank -%}
        <div class="hero__badge raised">
          <span class="hero__badge-value emboss">{{ s.badge_value | escape }}</span>
          <span class="hero__badge-text">{{ s.badge_text | escape }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner chính (Hero)",
  "class": "section-hero",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Dòng nhỏ phía trên", "default": "Chăm sóc trọn vẹn cho cả gia đình" },
    { "type": "inline_richtext", "id": "heading", "label": "Tiêu đề", "default": "Sống khỏe mỗi ngày, <em>yêu thương</em> trọn vẹn" },
    { "type": "richtext", "id": "text", "label": "Mô tả", "default": "<p>Sản phẩm chọn lọc cho sức khỏe, thú cưng và mẹ & bé – chính hãng, an toàn, giao nhanh toàn quốc.</p>" },
    { "type": "text", "id": "button_label", "label": "Nút chính", "default": "Mua sắm ngay" },
    { "type": "url", "id": "button_link", "label": "Liên kết nút chính" },
    { "type": "text", "id": "button2_label", "label": "Nút phụ", "default": "Xem danh mục" },
    { "type": "url", "id": "button2_link", "label": "Liên kết nút phụ" },
    { "type": "header", "content": "Hình ảnh" },
    { "type": "image_picker", "id": "image", "label": "Ảnh banner", "info": "Khuyên dùng ảnh vuông hoặc dọc, nền sáng, tối thiểu 1200px" },
    { "type": "color", "id": "glow_color", "label": "Màu vầng sáng phía sau ảnh", "default": "#cdeee8" },
    { "type": "product", "id": "product_a", "label": "Sản phẩm nổi bật 1" },
    { "type": "product", "id": "product_b", "label": "Sản phẩm nổi bật 2" },
    { "type": "text", "id": "badge_value", "label": "Huy hiệu – giá trị", "default": "4.9★" },
    { "type": "text", "id": "badge_text", "label": "Huy hiệu – nội dung", "default": "từ 20.000+ khách hàng" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Chỉ số",
      "settings": [
        { "type": "text", "id": "value", "label": "Giá trị", "default": "50K+" },
        { "type": "text", "id": "label", "label": "Mô tả", "default": "Khách hàng hài lòng" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner chính (Hero)",
      "blocks": [
        { "type": "stat", "settings": { "value": "50K+", "label": "Khách hàng" } },
        { "type": "stat", "settings": { "value": "1.200+", "label": "Sản phẩm" } },
        { "type": "stat", "settings": { "value": "24h", "label": "Giao nhanh" } }
      ]
    }
  ]
}
{% endschema %}
