<section class="section image-text">
  <div class="page-width image-text__grid{% if section.settings.image_right %} image-text__grid--reverse{% endif %}">
    <div class="image-text__media raised">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 990px) 50vw, 100vw' }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="image-text__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="h2 emboss">{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.blocks.size > 0 -%}
        <ul class="checklist">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}><span class="checklist__icon">{% render 'icon', name: 'check' %}</span>{{ block.settings.text | escape }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary">{{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow-right' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hình ảnh kèm nội dung",
  "class": "section-image-text",
  "max_blocks": 6,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Ảnh" },
    { "type": "checkbox", "id": "image_right", "label": "Ảnh bên phải", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Dòng nhỏ phía trên", "default": "Câu chuyện của chúng tôi" },
    { "type": "inline_richtext", "id": "heading", "label": "Tiêu đề", "default": "Chọn lọc kỹ càng cho người bạn yêu thương" },
    { "type": "richtext", "id": "text", "label": "Nội dung", "default": "<p>Mỗi sản phẩm đều được kiểm định chất lượng, có nguồn gốc rõ ràng và được đội ngũ chúng tôi dùng thử trước khi đến tay bạn.</p>" },
    { "type": "text", "id": "button_label", "label": "Nhãn nút", "default": "Tìm hiểu thêm" },
    { "type": "url", "id": "button_link", "label": "Liên kết nút" }
  ],
  "blocks": [
    { "type": "point", "name": "Điểm nổi bật", "settings": [{ "type": "text", "id": "text", "label": "Nội dung", "default": "Nguồn gốc rõ ràng" }] }
  ],
  "presets": [
    {
      "name": "Hình ảnh kèm nội dung",
      "blocks": [
        { "type": "point", "settings": { "text": "Nguồn gốc rõ ràng, chứng nhận an toàn" } },
        { "type": "point", "settings": { "text": "Tư vấn tận tâm bởi chuyên gia" } },
        { "type": "point", "settings": { "text": "Bảo hành và đổi trả dễ dàng" } }
      ]
    }
  ]
}
{% endschema %}
