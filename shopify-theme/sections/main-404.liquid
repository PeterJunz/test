    <h1 class="h2">{{ 'general.404_title' | t }}</h1>
    <p>{{ 'general.404_text' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'cart.continue' | t }} {% render 'icon', name: 'arrow-right' %}</a>
  </div>
</section>

