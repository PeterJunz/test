<section class="section">
  <div class="page-width">
    <div class="account__head">
      <h1 class="h1 emboss emboss--strong">{{ 'customer.account_title' | t }}</h1>
      <a href="{{ routes.account_logout_url }}" class="btn btn--soft btn--sm">{{ 'customer.log_out' | t }}</a>
    </div>
    <div class="account__grid">
      <div class="raised card-content">
        <h2 class="h3">{{ 'customer.orders' | t }}</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <table class="table">
              <thead><tr><th>{{ 'customer.order' | t }}</th><th>{{ 'customer.date' | t }}</th><th>{{ 'customer.status' | t }}</th><th>{{ 'customer.total' | t }}</th></tr></thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_price | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
            {% render 'pagination', paginate: paginate %}
          {%- else -%}
            <p>{{ 'customer.no_orders' | t }}</p>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
      <div class="raised card-content">
        <h2 class="h3">{{ 'customer.details' | t }}</h2>
        <p><strong>{{ customer.name }}</strong></p>
        <p>{{ customer.email }}</p>
        {{ customer.default_address | format_address }}
        <a href="{{ routes.account_addresses_url }}" class="link-arrow">{{ 'customer.addresses' | t }} ({{ customer.addresses_count }}) {% render 'icon', name: 'arrow-right' %}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Tài khoản", "settings": [] }
{% endschema %}
