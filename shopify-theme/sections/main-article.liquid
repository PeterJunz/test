<article class="section article">
  <div class="page-width page-width--narrow">
    <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span>/</span><a href="{{ blog.url }}">{{ blog.title | escape }}</a>
    </nav>
    <h1 class="h1 emboss emboss--strong">{{ article.title | escape }}</h1>
    <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }} · {{ article.author }}</p>
    {%- if article.image -%}
      <div class="article__image raised">
        {{ article.image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '720, 1080, 1400', sizes: '(min-width: 990px) 800px, 100vw' }}
      </div>
    {%- endif -%}
    <div class="rte card-content raised">{{ article.content }}</div>

    {%- if blog.comments_enabled? -%}
      <div class="article__comments">
        <h2 class="h3">{{ 'blog.comments' | t: count: article.comments_count }}</h2>
        {%- for comment in article.comments -%}
          <div class="comment inset">
            <div class="rte">{{ comment.content }}</div>
            <p class="eyebrow">{{ comment.author }} · {{ comment.created_at | time_tag: format: 'date' }}</p>
          </div>
        {%- endfor -%}
        {%- form 'new_comment', article, class: 'form raised' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success">{{ 'blog.comment_posted' | t }}</p>
          {%- endif -%}
          {{ form.errors | default_errors }}
          <label>{{ 'customer.name' | t }}<input type="text" name="comment[author]" value="{{ form.author }}" required></label>
          <label>{{ 'customer.email' | t }}<input type="email" name="comment[email]" value="{{ form.email }}" required></label>
          <label>{{ 'blog.comment' | t }}<textarea name="comment[body]" rows="4" required>{{ form.body }}</textarea></label>
          <button type="submit" class="btn btn--primary">{{ 'blog.post_comment' | t }}</button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</article>

{% schema %}
{ "name": "Bài viết", "settings": [] }
{% endschema %}
