<section class="section">
  <div class="page-width">
    <h1 class="h1 emboss emboss--strong page-title">{{ section.settings.heading | default: page_title }}</h1>
    <ul class="collection-grid">
      {%- for collection in collections -%}
        {%- if collection.products_count > 0 -%}
          <li>
            <a href="{{ collection.url }}" class="collection-card raised">
              <span class="collection-card__media">
                {%- if collection.featured_image -%}
                  {{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 50vw' }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </span>
              <span class="collection-card__info">
                <strong>{{ collection.title | escape }}</strong>
                <span>{{ 'collections.product_count' | t: count: collection.products_count }}</span>
              </span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Tất cả danh mục",
  "settings": [{ "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Tất cả danh mục" }]
}
{% endschema %}
