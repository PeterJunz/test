<section class="section password-page">
  <div class="page-width page-width--narrow">
    <div class="auth raised">
      <p class="header__logo-text emboss emboss--strong">{{ shop.name }}</p>
      <h1 class="h2">{{ section.settings.heading }}</h1>
      {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
      {% render 'newsletter-form', form_id: 'PasswordNewsletter' %}
      <details class="password-page__login">
        <summary class="link-arrow">{{ 'password.enter' | t }}</summary>
        {%- form 'storefront_password', class: 'form' -%}
          {{ form.errors | default_errors }}
          <label>{{ 'customer.password' | t }}<input type="password" name="password" required></label>
          <button type="submit" class="btn btn--primary btn--block">{{ 'password.enter' | t }}</button>
        {%- endform -%}
      </details>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trang mật khẩu",
  "settings": [{ "type": "inline_richtext", "id": "heading", "label": "Tiêu đề", "default": "Cửa hàng sắp ra mắt!" }]
}
{% endschema %}
