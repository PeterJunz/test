{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count
  assign active_media_id = current_variant.featured_media.id | default: product.featured_media.id
  assign discount = 0
  if current_variant.compare_at_price > current_variant.price
    assign discount = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif
-%}
<section class="section product" data-product data-section="{{ section.id }}">
  <div class="page-width">
    <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
      {%- if collection -%}<span>/</span><a href="{{ collection.url }}">{{ collection.title | escape }}</a>{%- endif -%}
      <span>/</span><span aria-current="page">{{ product.title | escape }}</span>
    </nav>

    <div class="product__grid">
      <div class="product__gallery" data-gallery>
        <div class="product__main-media raised">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              {%- liquid
                assign loading = 'lazy'
                if media.id == active_media_id
                  assign loading = 'eager'
                endif
              -%}
              <div class="product__media-item{% if media.id == active_media_id %} is-active{% endif %}" data-media-id="{{ media.id }}">
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    {{ media | image_url: width: 1200 | image_tag: loading: loading, widths: '480, 720, 960, 1200', sizes: '(min-width: 990px) 50vw, 100vw' }}
                  {%- when 'video', 'external_video' -%}
                    {{ media | media_tag: image_size: '1200x' }}
                  {%- else -%}
                    {{ media | media_tag }}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          {%- if discount > 0 -%}<span class="badge badge--sale product__badge" data-discount-badge>-{{ discount }}%</span>{%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <ul class="product__thumbs">
            {%- for media in product.media -%}
              <li>
                <button type="button" class="product__thumb raised" data-thumb="{{ media.id }}" aria-label="{{ 'products.view_media' | t: index: forloop.index }}">
                  {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'vendor' -%}
              {%- if product.vendor != blank -%}<p class="eyebrow" {{ block.shopify_attributes }}>{{ product.vendor | escape }}</p>{%- endif -%}

            {%- when 'title' -%}
              <h1 class="product__title emboss" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>
              {%- if rating != blank -%}
                {%- assign rating_5 = rating.rating | times: 5.0 | divided_by: rating.scale_max -%}
                <div class="product__rating">{% render 'rating-stars', rating: rating_5, count: rating_count %}</div>
              {%- endif -%}

            {%- when 'price' -%}
              <div class="product__price" {{ block.shopify_attributes }}>
                {% render 'price', product: product, variant: current_variant %}
                {%- if cart.taxes_included -%}<p class="product__tax">{{ 'products.tax_included' | t }}</p>{%- endif -%}
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="rte product__description" {{ block.shopify_attributes }}>{{ product.description }}</div>
              {%- endif -%}

            {%- when 'highlights' -%}
              <ul class="checklist" {{ block.shopify_attributes }}>
                {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
                {%- for line in lines -%}
                  {%- assign item = line | strip -%}
                  {%- if item != blank -%}<li><span class="checklist__icon">{% render 'icon', name: 'check' %}</span>{{ item | escape }}</li>{%- endif -%}
                {%- endfor -%}
              </ul>

            {%- when 'buy_buttons' -%}
              <div class="product__form-wrap" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: 'ProductForm', class: 'product-form', data-product-form: '', data-ajax-cart: '' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

                  {%- unless product.has_only_default_variant -%}
                    {%- for option in product.options_with_values -%}
                      <fieldset class="option">
                        <legend class="option__label">{{ option.name | escape }}: <span data-option-value="{{ forloop.index0 }}">{{ option.selected_value | escape }}</span></legend>
                        <div class="option__values">
                          {%- for value in option.values -%}
                            <label class="option__pill">
                              <input
                                type="radio"
                                name="option-{{ forloop.parentloop.index0 }}"
                                value="{{ value | escape }}"
                                data-option-index="{{ forloop.parentloop.index0 }}"
                                {% if option.selected_value == value %}checked{% endif %}
                              >
                              <span>{{ value | escape }}</span>
                            </label>
                          {%- endfor -%}
                        </div>
                      </fieldset>
                    {%- endfor -%}
                  {%- endunless -%}

                  <div class="product-form__row">
                    <div class="qty inset" data-qty>
                      <button type="button" data-qty-minus aria-label="{{ 'cart.decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                      <input type="number" name="quantity" value="1" min="1" aria-label="{{ 'cart.quantity' | t }}">
                      <button type="button" data-qty-plus aria-label="{{ 'cart.increase' | t }}">{% render 'icon', name: 'plus' %}</button>
                    </div>
                    <button type="submit" class="btn btn--primary btn--lg product-form__submit" data-add-button {% unless current_variant.available %}disabled data-sold-out{% endunless %}>
                      {% render 'icon', name: 'cart' %}
                      <span data-add-label>{% if current_variant.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
                    </button>
                  </div>
                  {%- if block.settings.show_dynamic_checkout -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                {%- endform -%}
                <script type="application/json" data-product-json>
                  {{ product | json }}
                </script>
              </div>

            {%- when 'trust' -%}
              <ul class="product__trust" {{ block.shopify_attributes }}>
                <li class="inset">{% render 'icon', name: 'truck' %}<span>{{ block.settings.text_1 | escape }}</span></li>
                <li class="inset">{% render 'icon', name: 'shield' %}<span>{{ block.settings.text_2 | escape }}</span></li>
                <li class="inset">{% render 'icon', name: 'return' %}<span>{{ block.settings.text_3 | escape }}</span></li>
              </ul>

            {%- when 'collapsible' -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.heading | escape }} {% render 'icon', name: 'chevron-down' %}</summary>
                <div class="rte accordion__content">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                </div>
              </details>

            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Thông tin sản phẩm",
  "class": "section-main-product",
  "settings": [],
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "Thương hiệu", "limit": 1 },
    { "type": "title", "name": "Tên sản phẩm", "limit": 1 },
    { "type": "price", "name": "Giá", "limit": 1 },
    {
      "type": "highlights",
      "name": "Điểm nổi bật",
      "settings": [
        { "type": "textarea", "id": "items", "label": "Mỗi dòng một ý", "default": "Chính hãng 100%\nAn toàn cho cả gia đình\nBảo hành 12 tháng" }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Nút mua hàng",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Hiện nút thanh toán nhanh", "default": true }
      ]
    },
    {
      "type": "trust",
      "name": "Cam kết",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text_1", "label": "Cam kết 1", "default": "Freeship từ 500K" },
        { "type": "text", "id": "text_2", "label": "Cam kết 2", "default": "Chính hãng 100%" },
        { "type": "text", "id": "text_3", "label": "Cam kết 3", "default": "Đổi trả 30 ngày" }
      ]
    },
    { "type": "description", "name": "Mô tả", "limit": 1 },
    {
      "type": "collapsible",
      "name": "Mục thu gọn",
      "settings": [
        { "type": "text", "id": "heading", "label": "Tiêu đề", "default": "Hướng dẫn sử dụng" },
        { "type": "richtext", "id": "content", "label": "Nội dung" },
        { "type": "page", "id": "page", "label": "Nội dung từ trang" }
      ]
    }
  ]
}
{% endschema %}
