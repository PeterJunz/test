<article class="article-card raised">
  <a href="{{ article.url }}" class="article-card__media">
    {%- if article.image -%}
      {{ article.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '(min-width: 990px) 33vw, 100vw' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>
  <div class="article-card__info">
    <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h3 class="article-card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
    <p>{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
    <a href="{{ article.url }}" class="link-arrow">{{ 'blog.read_more' | t }} {% render 'icon', name: 'arrow-right' %}</a>
  </div>
</article>
