{%- comment -%}
  Icon SVG nội tuyến.
  Cách dùng: {% render 'icon', name: 'cart' %}
{%- endcomment -%}
{%- capture attrs -%}class="icon icon--{{ name }}" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"{%- endcapture -%}
{%- case name -%}
  {%- when 'search' -%}
    <svg {{ attrs }}><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
  {%- when 'account' -%}
    <svg {{ attrs }}><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>
  {%- when 'cart' -%}
    <svg {{ attrs }}><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6"/><circle cx="10" cy="20.5" r="1.2"/><circle cx="18" cy="20.5" r="1.2"/></svg>
  {%- when 'menu' -%}
    <svg {{ attrs }}><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  {%- when 'close' -%}
    <svg {{ attrs }}><path d="M6 6l12 12M18 6 6 18"/></svg>
  {%- when 'chevron-down' -%}
    <svg {{ attrs }}><path d="m6 9 6 6 6-6"/></svg>
  {%- when 'chevron-left' -%}
    <svg {{ attrs }}><path d="m15 18-6-6 6-6"/></svg>
  {%- when 'chevron-right' -%}
    <svg {{ attrs }}><path d="m9 18 6-6-6-6"/></svg>
  {%- when 'arrow-right' -%}
    <svg {{ attrs }}><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  {%- when 'check' -%}
    <svg {{ attrs }}><path d="m5 12 5 5 9-10"/></svg>
  {%- when 'truck' -%}
    <svg {{ attrs }}><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
  {%- when 'shield' -%}
    <svg {{ attrs }}><path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6z"/><path d="m9 12 2 2 4-4"/></svg>
  {%- when 'lock' -%}
    <svg {{ attrs }}><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
  {%- when 'clock' -%}
    <svg {{ attrs }}><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
  {%- when 'leaf' -%}
    <svg {{ attrs }}><path d="M5 19c0-8 5-14 15-14 0 10-6 15-14 15"/><path d="M5 19c3-4 6-6 9-7.5"/></svg>
  {%- when 'heart' -%}
    <svg {{ attrs }}><path d="M12 20s-7-4.4-9-9a4.8 4.8 0 0 1 9-3 4.8 4.8 0 0 1 9 3c-2 4.6-9 9-9 9z"/></svg>
  {%- when 'paw' -%}
    <svg {{ attrs }}><circle cx="6" cy="10" r="1.8"/><circle cx="9.5" cy="5.5" r="1.8"/><circle cx="14.5" cy="5.5" r="1.8"/><circle cx="18" cy="10" r="1.8"/><path d="M12 11c-3 0-5.5 4-5.5 6.2 0 1.6 1.2 2.3 2.6 2.3 1.2 0 1.9-.6 2.9-.6s1.7.6 2.9.6c1.4 0 2.6-.7 2.6-2.3C17.5 15 15 11 12 11z"/></svg>
  {%- when 'baby' -%}
    <svg {{ attrs }}><circle cx="12" cy="12" r="9"/><path d="M9 10h.01M15 10h.01M9.5 15a3.5 3.5 0 0 0 5 0"/><path d="M12 3c-1 1.5-.5 3 1 3"/></svg>
  {%- when 'sparkle' -%}
    <svg {{ attrs }}><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/></svg>
  {%- when 'home' -%}
    <svg {{ attrs }}><path d="m3 11 9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg>
  {%- when 'activity' -%}
    <svg {{ attrs }}><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>
  {%- when 'gift' -%}
    <svg {{ attrs }}><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v8h14v-8M12 8v12M12 8S10.5 4 8 4a2 2 0 0 0 0 4M12 8s1.5-4 4-4a2 2 0 0 1 0 4"/></svg>
  {%- when 'return' -%}
    <svg {{ attrs }}><path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="m8 5-4 4 4 4"/></svg>
  {%- when 'phone' -%}
    <svg {{ attrs }}><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
  {%- when 'mail' -%}
    <svg {{ attrs }}><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
  {%- when 'pin' -%}
    <svg {{ attrs }}><path d="M12 21s7-6 7-11a7 7 0 0 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
  {%- when 'minus' -%}
    <svg {{ attrs }}><path d="M5 12h14"/></svg>
  {%- when 'plus' -%}
    <svg {{ attrs }}><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'trash' -%}
    <svg {{ attrs }}><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></svg>
  {%- when 'facebook' -%}
    <svg class="icon icon--{{ name }}" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M14 8V6.5c0-.7.5-1 1-1h2V2h-3c-3 0-4 2-4 4.5V8H8v3.5h2V22h4V11.5h3l.5-3.5z"/></svg>
  {%- when 'instagram' -%}
    <svg {{ attrs }}><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6" fill="currentColor"/></svg>
  {%- when 'tiktok' -%}
    <svg class="icon icon--{{ name }}" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 3c.4 2.3 1.8 3.8 4 4v3.3c-1.5 0-2.8-.4-4-1.2V15a6 6 0 1 1-6-6h.5v3.4a2.7 2.7 0 1 0 2.2 2.6V3z"/></svg>
  {%- when 'youtube' -%}
    <svg class="icon icon--{{ name }}" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M22 8.2a3 3 0 0 0-2.1-2.1C18 5.5 12 5.5 12 5.5s-6 0-7.9.6A3 3 0 0 0 2 8.2 31 31 0 0 0 1.5 12 31 31 0 0 0 2 15.8a3 3 0 0 0 2.1 2.1c1.9.6 7.9.6 7.9.6s6 0 7.9-.6a3 3 0 0 0 2.1-2.1c.4-1.2.5-2.5.5-3.8s-.1-2.6-.5-3.8zM10 15V9l5.2 3z"/></svg>
  {%- when 'star' -%}
    <svg class="icon icon--star" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="m12 2.8 2.8 5.8 6.4.9-4.6 4.5 1.1 6.3L12 17.3l-5.7 3 1.1-6.3L2.8 9.5l6.4-.9z"/></svg>
  {%- else -%}
    <svg {{ attrs }}><circle cx="12" cy="12" r="9"/></svg>
{%- endcase -%}
