{%- if paginate.pages > 1 -%}
  <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination' | t }}">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" class="pagination__item" aria-label="{{ 'general.previous' | t }}">
        {% render 'icon', name: 'chevron-left' %}
      </a>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}" class="pagination__item">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}
        <span class="pagination__item is-active" aria-current="page">{{ part.title }}</span>
      {%- else -%}
        <span class="pagination__item pagination__item--gap">{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" class="pagination__item" aria-label="{{ 'general.next' | t }}">
        {% render 'icon', name: 'chevron-right' %}
      </a>
    {%- endif -%}
  </nav>
{%- endif -%}
