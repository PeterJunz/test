{%- comment -%}
  Giá sản phẩm.
  - product: đối tượng product
  - variant: (tuỳ chọn) biến thể cụ thể
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare = target.compare_at_price
  if variant == blank and product.price_varies
    assign price = product.price_min
    assign compare = product.compare_at_price_min
  endif
  assign on_sale = false
  if compare > price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--on-sale{% endif %}" data-price>
  <span class="price__current" data-price-current>
    {%- if variant == blank and product.price_varies -%}
      {%- assign price_html = price | money -%}
      {{ 'products.from_price' | t: price: price_html }}
    {%- else -%}
      {{ price | money }}
    {%- endif -%}
  </span>
  <s class="price__compare" data-price-compare{% unless on_sale %} hidden{% endunless %}>
    {%- if on_sale %}{{ compare | money }}{% endif -%}
  </s>
</div>
