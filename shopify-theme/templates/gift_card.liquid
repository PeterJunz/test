{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t }} – {{ shop.name }}</title>
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="text-effect--{{ settings.text_effect }}">
    <main class="section">
      <div class="page-width page-width--narrow">
        <div class="auth raised gift-card">
          <p class="header__logo-text emboss emboss--strong">{{ shop.name }}</p>
          <h1 class="h2">{{ 'gift_card.title' | t }}</h1>
          <p class="gift-card__amount emboss emboss--strong">{{ gift_card.balance | money }}</p>
          {%- if gift_card.expired -%}<p class="badge badge--muted">{{ 'gift_card.expired' | t }}</p>{%- endif -%}
          <p class="gift-card__code inset">{{ gift_card.code | format_code }}</p>
          <div id="QrCode" class="gift-card__qr"></div>
          <a href="{{ shop.url }}" class="btn btn--primary btn--block">{{ 'cart.continue' | t }}</a>
        </div>
      </div>
    </main>
    <script>
      window.addEventListener('load', function () {
        if (window.QRCode) new QRCode(document.getElementById('QrCode'), { text: {{ gift_card.qr_identifier | json }}, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
