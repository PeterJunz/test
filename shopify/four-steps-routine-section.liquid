{%- comment -%}
  Dán link 4 ảnh HOẶC 4 video .mp4 (Shopify Admin → Content → Files → copy link) vào 4 dòng dưới.
  Link kết thúc bằng .mp4 sẽ tự hiện dạng video (tự chạy, tắt tiếng, lặp lại).
{%- endcomment -%}
{%- assign media_1 = 'https://cdn.shopify.com/YOUR-STEP-1.jpg' -%}
{%- assign media_2 = 'https://cdn.shopify.com/YOUR-STEP-2.jpg' -%}
{%- assign media_3 = 'https://cdn.shopify.com/YOUR-STEP-3.jpg' -%}
{%- assign media_4 = 'https://cdn.shopify.com/YOUR-STEP-4.jpg' -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700&family=Inter:wght@400;600&display=swap" rel="stylesheet">

<section class="routine">
  <div class="routine__inner">
    <h2 class="routine__title">LIGHT. MAGNIFY. CLIP. SMOOTH. DONE.</h2>
    <p class="routine__subtitle">A simple four-step routine to help you see clearer, trim safer, and smooth the edge after every cut.</p>

    <div class="routine__grid">
      {%- for i in (1..4) -%}
        {%- case i -%}
          {%- when 1 -%}
            {%- assign m = media_1 -%}{%- assign t = 'LIGHT THE NAIL' -%}{%- assign d = 'The built-in LED helps brighten the nail area before trimming.' -%}
          {%- when 2 -%}
            {%- assign m = media_2 -%}{%- assign t = 'CLEARER VIEW' -%}{%- assign d = 'The clear viewing cover helps make the nail area easier to inspect.' -%}
          {%- when 3 -%}
            {%- assign m = media_3 -%}{%- assign t = 'CLIP THE TIP' -%}{%- assign d = 'Trim only a tiny outer edge instead of cutting too deep.' -%}
          {%- when 4 -%}
            {%- assign m = media_4 -%}{%- assign t = 'SMOOTH THE EDGE' -%}{%- assign d = 'Use the grinder to gently round rough edges after clipping.' -%}
        {%- endcase -%}
        <div class="routine__item">
          <div class="routine__media">
            {%- assign m_lower = m | downcase | split: '?' | first -%}
            {%- if m_lower contains '.mp4' or m_lower contains '.mov' or m_lower contains '.webm' -%}
              <video src="{{ m }}" autoplay muted loop playsinline preload="metadata"></video>
            {%- else -%}
              <img src="{{ m }}" alt="{{ t | capitalize }}" loading="lazy" width="600" height="600">
            {%- endif -%}
          </div>
          <h3 class="routine__name">{{ t }}</h3>
          <p class="routine__desc">{{ d }}</p>
        </div>
      {%- endfor -%}
    </div>

    <p class="routine__note">5–10 minutes. Any breed. Any nail color.</p>
  </div>
</section>

<style>
  body { overflow-x: clip; }
  .routine {
    position: relative;
    width: 100%;
    max-width: none;
    background: #f6fdf9;
    padding: 56px 24px;
    box-sizing: border-box;
    text-align: center;
    font-family: 'Inter', sans-serif;
  }
  .routine__inner {
    max-width: 1150px;
    margin: 0 auto;
  }
  .routine__title {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 56px;
    line-height: 1.1;
    letter-spacing: .3px;
    color: #1f1f1f;
    margin: 0 0 14px;
  }
  .routine__subtitle {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.5;
    color: #222;
    margin: 0 0 30px;
  }
  .routine__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .routine__media {
    aspect-ratio: 1 / 1;
    border-radius: 14px;
    overflow: hidden;
    background: #e6ece9;
  }
  .routine__media img,
  .routine__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .routine__name {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 26px;
    line-height: 1.2;
    letter-spacing: .3px;
    color: #1f1f1f;
    margin: 14px 0 6px;
  }
  .routine__desc {
    font-size: 16px;
    line-height: 1.5;
    color: #555;
    max-width: 250px;
    margin: 0 auto;
  }
  .routine__note {
    display: inline-block;
    border-top: 1px solid #e0e6e3;
    padding-top: 22px;
    margin: 32px 0 0;
    font-size: 19px;
    color: #666;
  }
  @media (max-width: 989px) {
    .routine__title { font-size: 44px; }
    .routine__subtitle { font-size: 16px; }
    .routine__grid { grid-template-columns: repeat(2, 1fr); gap: 24px 14px; }
  }
  @media (max-width: 749px) {
    .routine { padding: 40px 16px; }
    .routine__title { font-size: 34px; }
    .routine__subtitle { font-size: 15px; margin-bottom: 22px; }
    .routine__grid { gap: 22px 12px; }
    .routine__name { font-size: 20px; margin-top: 10px; }
    .routine__desc { font-size: 14px; }
    .routine__note { font-size: 16px; margin-top: 24px; }
  }
</style>

<script>
  (function () {
    function fit() {
      var vw = document.documentElement.clientWidth;
      document.querySelectorAll('.routine').forEach(function (el) {
        el.style.width = vw + 'px';
        el.style.marginLeft = '0px';
        // Lặp vài lần để căn đúng giữa màn hình dù khung cha của theme lệch hay co giãn
        for (var i = 0; i < 3; i++) {
          var left = el.getBoundingClientRect().left;
          if (Math.abs(left) < 0.5) break;
          el.style.marginLeft = (parseFloat(el.style.marginLeft) - left) + 'px';
        }
      });
    }
    fit();
    window.addEventListener('load', fit);
    window.addEventListener('resize', fit);
    document.addEventListener('shopify:section:load', fit);
  })();
</script>
