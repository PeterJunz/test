{%- comment -%}
  Dán link ảnh sơ đồ thông số (ảnh đã có sẵn chữ chú thích) vào dòng dưới
  (Shopify Admin → Content → Files → copy link).
{%- endcomment -%}
{%- assign image_url = 'https://cdn.shopify.com/YOUR-SPECS-DIAGRAM.jpg' -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700&family=Inter:wght@500;600&display=swap" rel="stylesheet">

<section class="full-specs">
  <div class="full-specs__inner">
    <p class="full-specs__eyebrow">FULL SYSTEM SPECS</p>
    <h2 class="full-specs__title">BUILT FOR THE ENTIRE TRIM.<br>START TO FINISH.</h2>
    <p class="full-specs__lead">Every part works together to help you see clearer, cut cleaner, and finish smoother.</p>

    <div class="full-specs__media">
      <img src="{{ image_url }}" alt="QuickScan Pro parts diagram: magnifier, blade, grip, LED light, safety lock, USB-C charging, grinder and debris catcher" loading="lazy" width="1000" height="1040">
    </div>
  </div>
</section>

<style>
  body { overflow-x: clip; }
  .full-specs {
    position: relative;
    width: 100%;
    max-width: none;
    padding: 56px 24px;
    box-sizing: border-box;
    text-align: center;
    font-family: 'Inter', sans-serif;
  }
  .full-specs__inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .full-specs__eyebrow {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: .3px;
    color: #333;
    margin: 0 0 8px;
  }
  .full-specs__title {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 58px;
    line-height: 1.15;
    letter-spacing: .3px;
    color: #1f1f1f;
    margin: 0 0 16px;
  }
  .full-specs__lead {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.5;
    color: #222;
    margin: 0 0 32px;
  }
  .full-specs__media {
    max-width: 720px;
    margin: 0 auto;
    border-radius: 16px;
    overflow: hidden;
    background: #eee;
  }
  .full-specs__media img {
    width: 100%;
    height: auto;
    display: block;
  }
  @media (max-width: 989px) {
    .full-specs__title { font-size: 46px; }
    .full-specs__lead { font-size: 16px; }
  }
  @media (max-width: 749px) {
    .full-specs { padding: 40px 16px; }
    .full-specs__eyebrow { font-size: 14px; }
    .full-specs__title { font-size: 36px; }
    .full-specs__lead { font-size: 15px; margin-bottom: 22px; }
  }
</style>

<script>
  (function () {
    function fit() {
      var vw = document.documentElement.clientWidth;
      document.querySelectorAll('.full-specs').forEach(function (el) {
        el.style.width = vw + 'px';
        el.style.marginLeft = '0px';
        // Lặp vài lần để căn đúng giữa màn hình dù khung cha của theme lệch hay co giãn
        for (var i = 0; i < 3; i++) {
          var left = el.getBoundingClientRect().left;
          if (Math.abs(left) < 0.5) break;
          el.style.marginLeft = (parseFloat(el.style.marginLeft) - left) + 'px';
        }
      });
    }
    fit();
    window.addEventListener('load', fit);
    window.addEventListener('resize', fit);
    document.addEventListener('shopify:section:load', fit);
  })();
</script>
