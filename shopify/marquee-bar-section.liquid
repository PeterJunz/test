<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@500&display=swap" rel="stylesheet">

<div class="mq-bar" style="--mq-speed: 40s;">
  <div class="mq-bar__track">
    {%- comment -%} Nửa đầu và nửa sau giống hệt nhau để chạy nối tiếp liền mạch {%- endcomment -%}
    <div class="mq-bar__half">{{ mq_group }}{{ mq_group }}{{ mq_group }}</div>
    <div class="mq-bar__half" aria-hidden="true">{{ mq_group }}{{ mq_group }}{{ mq_group }}</div>
  </div>
</div>

<style>
  body { overflow-x: clip; }
  .mq-bar {
    position: relative;
    width: 100%;
    max-width: none;
    overflow: hidden;
    background: #7ee2c5;
    color: #1f1f1f;
    font-family: 'Inter', sans-serif;
    box-sizing: border-box;
  }
  .mq-bar__track {
    display: flex;
    width: max-content;
    animation: mq-bar-scroll var(--mq-speed, 40s) linear infinite;
  }
  .mq-bar:hover .mq-bar__track { animation-play-state: paused; }
  .mq-bar__half,
  .mq-bar__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .mq-bar__item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 0;
    white-space: nowrap;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.2;
  }
  .mq-bar__item svg {
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mq-bar__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    margin: 0 44px;
    flex-shrink: 0;
  }
  @keyframes mq-bar-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (max-width: 749px) {
    .mq-bar__item { font-size: 13px; gap: 8px; padding: 10px 0; }
    .mq-bar__item svg { width: 17px; height: 17px; flex-basis: 17px; }
    .mq-bar__dot { margin: 0 26px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mq-bar__track { animation-duration: calc(var(--mq-speed, 40s) * 3); }
  }
</style>

<script>
  (function () {
    function fit() {
      var vw = document.documentElement.clientWidth;
      document.querySelectorAll('.mq-bar').forEach(function (el) {
        el.style.width = vw + 'px';
        el.style.marginLeft = '0px';
        // Lặp vài lần để căn đúng giữa màn hình dù khung cha của theme lệch hay co giãn
        for (var i = 0; i < 3; i++) {
          var left = el.getBoundingClientRect().left;
          if (Math.abs(left) < 0.5) break;
          el.style.marginLeft = (parseFloat(el.style.marginLeft) - left) + 'px';
        }
      });
    }
    fit();
    window.addEventListener('load', fit);
    window.addEventListener('resize', fit);
    document.addEventListener('shopify:section:load', fit);
  })();
</script>
