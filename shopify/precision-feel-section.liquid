{%- comment -%}
  Dán link ảnh vào dòng dưới (Shopify Admin → Content → Files → copy link).
{%- endcomment -%}
{%- assign image_url = 'https://cdn.shopify.com/YOUR-PRODUCT-IN-HAND-IMAGE.jpg' -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

<section class="prec-feel">
  <div class="prec-feel__inner">
    <div class="prec-feel__media">
      <img src="{{ image_url }}" alt="Hand holding the QuickScan Pro nail clipper" loading="lazy" width="800" height="800">
    </div>

    <div class="prec-feel__text">
      <h2 class="prec-feel__title">PRECISION YOU CAN FEEL BEFORE YOU USE IT.</h2>
      <p class="prec-feel__lead">QuickScan Pro™ is light enough to maneuver around any paw, weighted enough to feel like a professional instrument.</p>
      <p class="prec-feel__lead">Every surface is intentional, every material chosen for grip, durability and longevity.</p>

      <div class="prec-feel__item">
        <h3 class="prec-feel__item-title">BALANCED BODY</h3>
        <p class="prec-feel__item-desc">6.84 oz balanced feel with steady control</p>
      </div>
      <div class="prec-feel__item">
        <h3 class="prec-feel__item-title">SOFT-GRIP HOLD</h3>
        <p class="prec-feel__item-desc">Textured surface for confident trimming</p>
      </div>
      <div class="prec-feel__item">
        <h3 class="prec-feel__item-title">EASY TO GUIDE</h3>
        <p class="prec-feel__item-desc">Lightweight movement without feeling flimsy</p>
      </div>
    </div>
  </div>
</section>

<style>
  body { overflow-x: clip; }
  .prec-feel {
    position: relative;
    width: 100%;
    max-width: none;
    padding: 56px 24px;
    box-sizing: border-box;
    font-family: 'Inter', sans-serif;
    color: #1f1f1f;
  }
  .prec-feel__inner {
    max-width: 1150px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .prec-feel__media {
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    overflow: hidden;
    background: #eee;
  }
  .prec-feel__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .prec-feel__title {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 54px;
    line-height: 1.25;
    letter-spacing: .3px;
    color: #1f1f1f;
    margin: 0 0 18px;
  }
  .prec-feel__lead {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    color: #222;
    margin: 0 0 16px;
  }
  .prec-feel__item { margin: 24px 0 0; }
  .prec-feel__item + .prec-feel__item { margin-top: 20px; }
  .prec-feel__item-title {
    font-family: 'Inter', sans-serif;
    font-size: 21px;
    font-weight: 700;
    line-height: 1.3;
    color: #1f1f1f;
    margin: 0 0 4px;
  }
  .prec-feel__item-desc {
    font-size: 16px;
    line-height: 1.5;
    color: #555;
    margin: 0;
  }
  @media (max-width: 989px) {
    .prec-feel__inner { gap: 40px; }
    .prec-feel__title { font-size: 44px; }
    .prec-feel__lead { font-size: 16px; }
    .prec-feel__item-title { font-size: 19px; }
  }
  @media (max-width: 749px) {
    .prec-feel { padding: 40px 16px; }
    .prec-feel__inner { grid-template-columns: 1fr; gap: 28px; }
    .prec-feel__media { max-width: 480px; width: 100%; margin: 0 auto; }
    .prec-feel__title { font-size: 36px; }
    .prec-feel__lead { font-size: 15px; }
    .prec-feel__item-title { font-size: 18px; }
    .prec-feel__item-desc { font-size: 15px; }
  }
</style>

<script>
  (function () {
    function fit() {
      var vw = document.documentElement.clientWidth;
      document.querySelectorAll('.prec-feel').forEach(function (el) {
        el.style.width = vw + 'px';
        el.style.marginLeft = '0px';
        // Lặp vài lần để căn đúng giữa màn hình dù khung cha của theme lệch hay co giãn
        for (var i = 0; i < 3; i++) {
          var left = el.getBoundingClientRect().left;
          if (Math.abs(left) < 0.5) break;
          el.style.marginLeft = (parseFloat(el.style.marginLeft) - left) + 'px';
        }
      });
    }
    fit();
    window.addEventListener('load', fit);
    window.addEventListener('resize', fit);
    document.addEventListener('shopify:section:load', fit);
  })();
</script>
