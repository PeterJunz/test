{%- comment -%}
  Dán link ảnh (Shopify Admin → Content → Files → copy link) vào 3 dòng dưới.
  Nếu ảnh của bạn ĐÃ có sẵn huy hiệu "NOT EFFECTIVE", đổi show_badge thành false.
{%- endcomment -%}
{%- assign img_1 = 'https://cdn.shopify.com/YOUR-VACUUM-IMAGE.jpg' -%}
{%- assign img_2 = 'https://cdn.shopify.com/YOUR-LINT-ROLLER-IMAGE.jpg' -%}
{%- assign img_3 = 'https://cdn.shopify.com/YOUR-RUBBER-BRUSH-IMAGE.jpg' -%}
{%- assign show_badge = true -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Inter:wght@500&display=swap" rel="stylesheet">

<section class="wrong-tools">
  <div class="wrong-tools__inner">
  <h2 class="wrong-tools__title">You’re not bad at cleaning.<br>Your tools are just wrong.</h2>

  <div class="wrong-tools__grid">
    <div class="wrong-tools__card">
      <div class="wrong-tools__media">
        <img src="{{ img_1 }}" alt="Vacuum on a couch covered in pet hair" loading="lazy" width="600" height="540">
        {%- if show_badge -%}<span class="wrong-tools__badge">NOT<br>EFFECTIVE</span>{%- endif -%}
      </div>
      <h3 class="wrong-tools__name">Vacuum</h3>
      <p class="wrong-tools__desc">Suction can't break embedded hair.</p>
    </div>

    <div class="wrong-tools__card">
      <div class="wrong-tools__media">
        <img src="{{ img_2 }}" alt="Lint roller on a couch covered in pet hair" loading="lazy" width="600" height="540">
        {%- if show_badge -%}<span class="wrong-tools__badge">NOT<br>EFFECTIVE</span>{%- endif -%}
      </div>
      <h3 class="wrong-tools__name">Lint Roller</h3>
      <p class="wrong-tools__desc">Only grabs surface fuzz.</p>
    </div>

    <div class="wrong-tools__card">
      <div class="wrong-tools__media">
        <img src="{{ img_3 }}" alt="Rubber brush on a couch covered in pet hair" loading="lazy" width="600" height="540">
        {%- if show_badge -%}<span class="wrong-tools__badge">NOT<br>EFFECTIVE</span>{%- endif -%}
      </div>
      <h3 class="wrong-tools__name">Rubber Brush</h3>
      <p class="wrong-tools__desc">Flattens hair instead of removing it.</p>
    </div>
  </div>

  <p class="wrong-tools__footer">Your tools weren’t engineered for embedded pet hair.</p>
  </div>
</section>

<style>
  body { overflow-x: clip; }
  .wrong-tools {
    position: relative;
    width: 100%;
    max-width: none;
    padding: 56px 24px;
    text-align: center;
    box-sizing: border-box;
  }
  .wrong-tools__inner {
    max-width: 1200px;
    margin: 0 auto;
    box-sizing: border-box;
  }
  .wrong-tools__title {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 52px;
    line-height: 1.25;
    letter-spacing: -0.3px;
    color: #1a1a1a;
    margin: 0 0 28px;
  }
  .wrong-tools__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .wrong-tools__media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 10 / 9;
    background: #eee;
    container-type: inline-size;
  }
  .wrong-tools__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .wrong-tools__badge {
    position: absolute;
    right: 4%;
    bottom: 4%;
    width: 30%;
    aspect-ratio: 1;
    box-sizing: border-box;
    padding: 0 4%;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #c9343f, #a3202b);
    box-shadow: inset 0 0 0 3px #a3202b, inset 0 0 0 5px rgba(255,255,255,.85), 0 2px 6px rgba(0,0,0,.25);
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 14px;
    font-size: 4.2cqw;
    line-height: 1.15;
    letter-spacing: 0;
    text-transform: none;
    white-space: nowrap;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    transform: rotate(-8deg);
  }
  .wrong-tools__name {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 34px;
    line-height: 1.2;
    color: #1a1a1a;
    margin: 18px 0 6px;
  }
  .wrong-tools__desc {
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 18px;
    line-height: 1.5;
    color: #666;
    margin: 0;
  }
  .wrong-tools__footer {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 38px;
    line-height: 1.25;
    color: #444;
    margin: 36px 0 0;
  }
  @media (max-width: 989px) {
    .wrong-tools__title { font-size: 42px; }
    .wrong-tools__name { font-size: 28px; }
    .wrong-tools__desc { font-size: 16px; }
    .wrong-tools__footer { font-size: 30px; }
  }
  @media (max-width: 749px) {
    .wrong-tools { padding: 36px 16px; }
    .wrong-tools__title { font-size: 34px; margin-bottom: 20px; }
    .wrong-tools__grid { grid-template-columns: 1fr; gap: 28px; max-width: 480px; margin: 0 auto; }
    .wrong-tools__name { font-size: 28px; }
    .wrong-tools__desc { font-size: 16px; }
    .wrong-tools__footer { font-size: 28px; }
  }
</style>

<script>
  (function () {
    function fit() {
      var vw = document.documentElement.clientWidth;
      document.querySelectorAll('.wrong-tools').forEach(function (el) {
        el.style.width = vw + 'px';
        el.style.marginLeft = '0px';
        // Lặp vài lần để căn đúng giữa màn hình dù khung cha của theme lệch hay co giãn
        for (var i = 0; i < 3; i++) {
          var left = el.getBoundingClientRect().left;
          if (Math.abs(left) < 0.5) break;
          el.style.marginLeft = (parseFloat(el.style.marginLeft) - left) + 'px';
        }
      });
    }
    fit();
    window.addEventListener('load', fit);
    window.addEventListener('resize', fit);
    document.addEventListener('shopify:section:load', fit);
  })();
</script>
