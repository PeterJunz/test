<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_midnight }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    <title>{{ shop.name }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {% render 'meta-tags' %}
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'immersive.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script>document.documentElement.classList.replace('no-js', 'js');window.Velora={routes:{},motion:{depth:{{ settings.animations_depth | json }},reveal:true},strings:{emailInvalid:{{ 'newsletter.invalid' | t | json }}}};</script>
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent" class="main-content">
      {{ content_for_layout }}
    </main>
  </body>
</html>
