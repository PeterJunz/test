<!doctype html>
<html class="no-js{% unless settings.animations_reveal %} no-reveal{% endunless %}" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_midnight }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- unless settings.type_heading_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{- page_title -}}
      {%- if current_tags -%}{%- assign tag_list = current_tags | join: ', ' -%} &ndash; {{ 'general.tagged_with' | t: tags: tag_list }}{%- endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}
    {% render 'css-variables' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'immersive.css' | asset_url | stylesheet_tag: preload: true }}

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script>
      document.documentElement.classList.replace('no-js', 'js');
      window.Velora = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        motion: {
          depth: {{ settings.animations_depth | json }},
          reveal: {{ settings.animations_reveal | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          cartError: {{ 'cart.error' | t | json }},
          emailInvalid: {{ 'newsletter.invalid' | t | json }},
          copied: {{ 'products.product.copied' | t | json }},
          cartUpdated: {{ 'cart.updated' | t | json }},
          qtyLimited: {{ 'cart.qty_limited' | t | json }}
        }
      };
    </script>

    {{ content_for_header }}

    {%- render 'structured-data' -%}
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.suffix | handle }}{% endif %}{% unless settings.animations_ambient %} no-ambient{% endunless %}">
    <a class="skip-link visually-hidden-focusable" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    <div class="toast" role="status" aria-live="polite" aria-atomic="true" data-toast></div>

    {%- if settings.predictive_search -%}
      {% render 'search-modal' %}
    {%- endif -%}
  </body>
</html>
