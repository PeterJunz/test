{%- liquid
  assign messages = section.blocks
  assign scroll = section.settings.scrolling
-%}
{%- if messages.size > 0 -%}
  <div class="announcement{% if scroll %} announcement--marquee{% endif %}" style="--ann-bg: {{ section.settings.background }}; --ann-fg: {{ section.settings.text_color }};" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
    {%- if scroll -%}
      <div class="announcement__track">
        {%- for i in (1..2) -%}
          <div class="announcement__group"{% if forloop.last %} aria-hidden="true"{% endif %}>
            {%- for block in messages -%}
              <p class="announcement__msg" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank and forloop.parentloop.first -%}
                  <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
                {%- elsif block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" tabindex="-1">{{ block.settings.text | escape }}</a>
                {%- else -%}
                  {{ block.settings.text | escape }}
                {%- endif -%}
                <span class="announcement__dot" aria-hidden="true">✦</span>
              </p>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="page-width announcement__static">
        {%- for block in messages -%}
          <p class="announcement__msg" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }} {% render 'icon', name: 'arrow-right', size: 14 %}</a>
            {%- else -%}
              {{ block.settings.text | escape }}
            {%- endif -%}
          </p>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "scrolling", "label": "Scrolling marquee", "default": false, "info": "Scrolling pauses on hover and is disabled for visitors who prefer reduced motion." },
    { "type": "color", "id": "background", "label": "Background", "default": "#101820" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F7F5F0" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "COMFORT THAT FITS YOUR EVERYDAY LIFE — EXPLORE OUR COLLECTION" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Announcement bar", "blocks": [{ "type": "message" }] }
  ]
}
{% endschema %}
