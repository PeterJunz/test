<section class="section areas scheme-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--wide">
    {% render 'section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      link_label: section.settings.link_label,
      link_url: section.settings.link_url
    %}
    <ul class="areas__grid areas__grid--{{ section.blocks.size }}" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign target = block.settings.collection
          assign url = block.settings.link | default: target.url
          assign img = block.settings.image | default: target.featured_image
          assign title = block.settings.title | default: target.title
        -%}
        <li class="area-card" data-reveal style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <div class="area-card__inner" data-tilt>
            <div class="area-card__media">
              {%- if img != blank -%}
                {{ img | image_url: width: 1200 | image_tag:
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 85vw',
                  loading: 'lazy',
                  alt: img.alt | default: title
                }}
              {%- else -%}
                <div class="area-card__art">{% render 'body-area-art', area: block.settings.art %}</div>
              {%- endif -%}
            </div>
            <div class="area-card__body">
              <span class="area-card__index" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <h3 class="h3 area-card__title">
                {%- if url != blank -%}
                  <a href="{{ url }}" class="stretched-link">{{ title | escape }}</a>
                {%- else -%}
                  {{ title | escape }}
                {%- endif -%}
              </h3>
              {%- if block.settings.text != blank -%}<p class="area-card__text">{{ block.settings.text | escape }}</p>{%- endif -%}
              {%- if url != blank -%}
                <span class="area-card__cta" aria-hidden="true">{% render 'icon', name: 'arrow-up-right', size: 20 %}</span>
              {%- endif -%}
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Shop by body area",
  "class": "section-areas",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by body area" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Comfort, <em>right where</em> you need it" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All collections" },
    { "type": "url", "id": "link_url", "label": "Link", "default": "/collections" },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "default": "light", "options": [
      { "value": "light", "label": "Ivory" },
      { "value": "white", "label": "White" },
      { "value": "sage", "label": "Sage" },
      { "value": "dark", "label": "Midnight" }
    ] }
  ],
  "blocks": [
    {
      "type": "area",
      "name": "Body area",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Provides the default link, title and image." },
        { "type": "text", "id": "title", "label": "Title", "default": "Neck & Shoulders" },
        { "type": "text", "id": "text", "label": "Description", "default": "Unwind the areas that carry your day." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link override" },
        { "type": "select", "id": "art", "label": "Illustration (when no image)", "default": "neck", "options": [
          { "value": "neck", "label": "Neck & shoulders" },
          { "value": "back", "label": "Back & lumbar" },
          { "value": "feet", "label": "Feet & legs" },
          { "value": "full", "label": "Full body" },
          { "value": "portable", "label": "Portable" }
        ] }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by body area",
      "blocks": [
        { "type": "area", "settings": { "title": "Neck & Shoulders", "text": "Unwind the areas that carry your day.", "art": "neck" } },
        { "type": "area", "settings": { "title": "Back & Lumbar", "text": "Support for long desk days and slow evenings.", "art": "back" } },
        { "type": "area", "settings": { "title": "Feet & Legs", "text": "A restful reset after time on your feet.", "art": "feet" } },
        { "type": "area", "settings": { "title": "Full Body", "text": "Cushions and seats for a complete wind-down.", "art": "full" } },
        { "type": "area", "settings": { "title": "Portable Massage", "text": "Compact comfort for home, office and travel.", "art": "portable" } }
      ]
    }
  ]
}
{% endschema %}
