<footer class="footer scheme-dark">
  <div class="footer__glow" aria-hidden="true"></div>
  <div class="page-width page-width--wide">
    {%- if section.settings.statement != blank -%}
      <p class="footer__statement display" data-reveal>{{ section.settings.statement }}</p>
    {%- endif -%}

    <div class="footer__grid">
      {%- for block in section.blocks -%}
        <div class="footer__col footer__col--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'brand' -%}
              <a href="{{ routes.root_url }}" class="footer__logo">
                {%- if settings.logo_inverse != blank -%}
                  {{ settings.logo_inverse | image_url: width: 400 | image_tag: loading: 'lazy', alt: shop.name, style: 'max-width: 160px; height: auto;' }}
                {%- else -%}
                  <span class="wordmark">{{ settings.brand_wordmark | default: shop.name | escape }}</span>
                {%- endif -%}
              </a>
              {%- if block.settings.text != blank -%}
                <div class="footer__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.show_social -%}{% render 'social-icons' %}{%- endif -%}
            {%- when 'menu' -%}
              {%- if block.settings.heading != blank -%}<h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
              <ul role="list" class="footer__links">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- when 'contact' -%}
              {%- if block.settings.heading != blank -%}<h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
              <div class="footer__text rte">{{ block.settings.text }}</div>
            {%- when 'newsletter' -%}
              {%- if block.settings.heading != blank -%}<h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>{%- endif -%}
              {%- if block.settings.text != blank -%}<div class="footer__text rte">{{ block.settings.text }}</div>{%- endif -%}
              {% render 'newsletter-form', form_id: 'FooterNewsletter' %}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <div class="footer__legal">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</p>
        {%- if section.settings.show_policies and shop.policies.size > 0 -%}
          <ul role="list" class="footer__policies">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="footer__meta">
        {%- if section.settings.show_localization -%}
          {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
            {%- form 'localization', class: 'localization', data-localization: '' -%}
              {%- if localization.available_countries.size > 1 -%}
                <div class="select-wrap">
                  <label class="visually-hidden" for="FooterCountry">{{ 'localization.country' | t }}</label>
                  <select id="FooterCountry" name="country_code" data-autosubmit>
                    {%- for country in localization.available_countries -%}
                      <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                        {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                      </option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endif -%}
              {%- if localization.available_languages.size > 1 -%}
                <div class="select-wrap">
                  <label class="visually-hidden" for="FooterLanguage">{{ 'localization.language' | t }}</label>
                  <select id="FooterLanguage" name="language_code" data-autosubmit>
                    {%- for language in localization.available_languages -%}
                      <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endif -%}
              <noscript><button type="submit" class="btn btn--ghost btn--sm">{{ 'localization.update' | t }}</button></noscript>
            {%- endform -%}
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <ul class="payment-icons" role="list" aria-label="{{ 'footer.payment' | t }}">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 6,
  "settings": [
    { "type": "inline_richtext", "id": "statement", "label": "Large brand statement", "default": "Comfort, <em>every day.</em>" },
    { "type": "checkbox", "id": "show_policies", "label": "Show policy links", "default": true },
    { "type": "checkbox", "id": "show_localization", "label": "Show country and language selectors", "default": true, "info": "Requires Shopify Markets or multiple published languages." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Description", "default": "<p>Thoughtfully designed wellness essentials for calmer evenings and more comfortable everyday routines at home.</p>" },
        { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": true }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Support" },
        { "type": "richtext", "id": "text", "label": "Contact details", "default": "<p>Add your support email, phone number and hours here.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in the calm" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>New arrivals, care guides and members-first news.</p>" }
      ]
    }
  ]
}
{% endschema %}
