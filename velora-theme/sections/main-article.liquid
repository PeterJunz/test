<article class="article">
  <header class="article__head page-width page-width--narrow">
    {% render 'breadcrumbs' %}
    <p class="eyebrow">{{ article.published_at | time_tag: format: 'month_day_year' }}{% if section.settings.show_author %} · {{ article.author | escape }}{% endif %}</p>
    <h1 class="h1 display">{{ article.title | escape }}</h1>
  </header>
  {%- if article.image -%}
    <div class="article__media page-width page-width--wide">
      {{ article.image | image_url: width: 2000 | image_tag: widths: '750, 1100, 1500, 2000', sizes: '(min-width: 1440px) 1400px, 100vw', loading: 'eager', fetchpriority: 'high', alt: article.image.alt | default: article.title }}
    </div>
  {%- endif -%}
  <div class="page-width page-width--narrow">
    <div class="rte article__content">{{ article.content }}</div>
    {%- if article.tags.size > 0 -%}
      <ul class="article__tags" role="list">
        {%- for tag in article.tags -%}<li><a class="chip" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag | escape }}</a></li>{%- endfor -%}
      </ul>
    {%- endif -%}
    <a href="{{ blog.url }}" class="link-arrow">{% render 'icon', name: 'arrow-left', size: 18 %} {{ 'blogs.back' | t: title: blog.title }}</a>

    {%- if blog.comments_enabled? -%}
      <section class="comments" aria-labelledby="CommentsTitle">
        <h2 class="h3" id="CommentsTitle">{{ 'blogs.comments.title' | t: count: article.comments_count }}</h2>
        {%- paginate article.comments by 10 -%}
          <ul class="comments__list" role="list">
            {%- for comment in article.comments -%}
              <li class="comment">
                <div class="rte">{{ comment.content }}</div>
                <p class="muted">{{ comment.author | escape }} · {{ comment.created_at | time_tag: format: 'month_day_year' }}</p>
              </li>
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
        {%- form 'new_comment', article, class: 'form' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" role="status">
              {%- if blog.moderated? -%}{{ 'blogs.comments.success_moderated' | t }}{%- else -%}{{ 'blogs.comments.success' | t }}{%- endif -%}
            </p>
          {%- endif -%}
          {{ form.errors | default_errors }}
          <div class="form__row">
            <div class="field"><label for="CommentAuthor">{{ 'contact.name' | t }}</label><input id="CommentAuthor" type="text" name="comment[author]" value="{{ form.author }}" required autocomplete="name"></div>
            <div class="field"><label for="CommentEmail">{{ 'contact.email' | t }}</label><input id="CommentEmail" type="email" name="comment[email]" value="{{ form.email }}" required autocomplete="email"></div>
          </div>
          <div class="field"><label for="CommentBody">{{ 'contact.message' | t }}</label><textarea id="CommentBody" name="comment[body]" rows="5" required>{{ form.body }}</textarea></div>
          <button type="submit" class="btn btn--primary">{{ 'blogs.comments.post' | t }}</button>
        {%- endform -%}
      </section>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "Blog post",
  "class": "section-main-article",
  "settings": [{ "type": "checkbox", "id": "show_author", "label": "Show author", "default": true }]
}
{% endschema %}
