<section class="password scheme-dark">
  <div class="hero__ambient" aria-hidden="true"><span class="orb orb--a"></span><span class="orb orb--b"></span><span class="orb orb--c"></span></div>
  <div class="page-width page-width--narrow password__inner">
    <p class="wordmark password__brand">{{ settings.brand_wordmark | default: shop.name | escape }}</p>
    <h1 class="h0 display">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
    {% render 'newsletter-form', form_id: 'PasswordNewsletter', button_label: section.settings.button_label %}

    <details class="password__login">
      <summary>{{ 'password.enter_store' | t }}</summary>
      {%- form 'storefront_password', class: 'form' -%}
        {{ form.errors | default_errors }}
        <div class="field">
          <label for="StorePassword">{{ 'password.label' | t }}</label>
          <input id="StorePassword" type="password" name="password" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn--glass btn--block">{{ 'password.enter' | t }}</button>
      {%- endform -%}
    </details>
    <p class="muted password__admin">{{ 'password.admin_html' | t: link: '/admin' }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "class": "section-password",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Something <em>calm</em> is coming" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Notify me" }
  ]
}
{% endschema %}
