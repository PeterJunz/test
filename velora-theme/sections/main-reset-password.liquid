<section class="section auth">
  <div class="page-width page-width--narrow">
    <div class="auth__card">
      <h1 class="h2 display">{{ 'customer.reset.title' | t }}</h1>
      {%- form 'reset_customer_password', class: 'form' -%}
        {{ form.errors | default_errors }}
        <div class="field"><label for="ResetPass">{{ 'customer.fields.password' | t }}</label><input id="ResetPass" type="password" name="customer[password]" autocomplete="new-password" required></div>
        <div class="field"><label for="ResetPass2">{{ 'customer.fields.password_confirm' | t }}</label><input id="ResetPass2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
        <button type="submit" class="btn btn--primary btn--block">{{ 'customer.reset.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Reset password", "class": "section-auth", "settings": [] }
{% endschema %}
