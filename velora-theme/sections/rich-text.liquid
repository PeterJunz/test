<section class="section rich scheme-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow rich__inner rich__inner--{{ section.settings.align }}" data-reveal>
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}<p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
        {%- when 'heading' -%}<h2 class="{{ block.settings.size }} display" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
        {%- when 'text' -%}<div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          {%- if block.settings.label != blank and block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="btn btn--{{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "class": "section-rich",
  "settings": [
    { "type": "select", "id": "align", "label": "Alignment", "default": "center", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ] },
    { "type": "select", "id": "color_scheme", "label": "Color scheme", "default": "light", "options": [
      { "value": "light", "label": "Ivory" },
      { "value": "white", "label": "White" },
      { "value": "sage", "label": "Sage" },
      { "value": "dark", "label": "Midnight" }
    ] }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Eyebrow", "limit": 1, "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Our technology" }] },
    { "type": "heading", "name": "Heading", "settings": [
      { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Designed around <em>you</em>" },
      { "type": "select", "id": "size", "label": "Size", "default": "h1", "options": [
        { "value": "h2", "label": "Medium" }, { "value": "h1", "label": "Large" }, { "value": "h0", "label": "Extra large" }
      ] }
    ] },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share your design process, materials and the thinking behind your products.</p>" }] },
    { "type": "button", "name": "Button", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Learn more" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "select", "id": "style", "label": "Style", "default": "primary", "options": [
        { "value": "primary", "label": "Solid" }, { "value": "ghost", "label": "Outline" }
      ] }
    ] }
  ],
  "presets": [{ "name": "Rich text", "blocks": [{ "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }] }]
}
{% endschema %}
