{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    {%- assign initial = gift_card.initial_value | money -%}
    <title>{{ 'gift_card.title' | t: value: initial }} — {{ shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main class="section gift-card scheme-dark">
      <div class="page-width page-width--narrow gift-card__inner">
        <p class="wordmark">{{ settings.brand_wordmark | default: shop.name | escape }}</p>
        <h1 class="h1 display">{{ 'gift_card.title' | t: value: initial }}</h1>
        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="badge badge--muted">{{ 'gift_card.expired' | t }}</p>
        {%- endif -%}
        {%- assign balance = gift_card.balance | money -%}
        <p class="h3">{{ 'gift_card.balance' | t: value: balance }}</p>
        <div class="gift-card__code">
          <label for="GiftCode" class="visually-hidden">{{ 'gift_card.code' | t }}</label>
          <input id="GiftCode" type="text" readonly value="{{ gift_card.code | format_code }}">
        </div>
        <div id="QrCode" class="gift-card__qr" data-identifier="{{ gift_card.qr_identifier }}"></div>
        <div class="hero__ctas">
          <a href="{{ shop.url }}" class="btn btn--primary">{{ 'gift_card.shop' | t }}</a>
          {%- if gift_card.pass_url -%}
            <a href="{{ gift_card.pass_url }}" class="btn btn--glass">{{ 'gift_card.wallet' | t }}</a>
          {%- endif -%}
          <button type="button" class="btn btn--glass" onclick="window.print();">{{ 'gift_card.print' | t }}</button>
        </div>
      </div>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (el && window.QRCode) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
